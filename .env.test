# 测试环境配置文件
# 用于 RBAC 系统验证测试

# 数据库配置
DATABASE_URL="postgresql://user:password@localhost:5432/aiops_test"

# JWT 配置
JWT_SECRET="test-secret-key-change-in-production-do-not-use-this-in-real-environment"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# 服务器配置
PORT=3001
NODE_ENV="test"

# 日志配置
LOG_LEVEL="error"

# CORS 配置
CORS_ORIGIN="http://localhost:5173"
