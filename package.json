{
  "name": "shadcn-admin",
  "private": false,
  "version": "2.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "OPENCODE_PORT=4096 tsx watch -r dotenv/config server/index.ts",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:server\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:comments": "tsx scripts/generate-db-comments.ts && prisma migrate deploy",
    "db:migrate:full": "prisma migrate dev && tsx scripts/generate-db-comments.ts && prisma migrate deploy"
  },
