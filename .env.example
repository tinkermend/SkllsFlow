# 后端服务器配置
PORT=3001

# 前端开发服务器
VITE_API_URL=/api

# API 模式切换
# 设置为 true 时使用前端 Mock 数据（不请求后端）
# 设置为 false 时使用真实后端 API
VITE_MOCK=true

# OpenCode 配置
# 如果已手动启动 OpenCode 实例，设置以下环境变量
# 格式: http://host:port 或 https://host:port
# 示例: OPENCODE_API_URL=http://localhost:4096
# OPENCODE_API_URL=


# 用户会话目录配置
# OpenCode serve 默认启动路径
OPENCODE_BASE_PATH=/Users/wangpei/src/singe/SkllsFlow/user_session

# 认证配置
# 设置为 true 以强制要求认证（生产环境）
REQUIRE_AUTH=false
