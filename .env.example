# 后端服务器配置
PORT=3001

# 前端开发服务器
VITE_BACKEND_API_URL=/api

# OpenCode 配置
# 如果已手动启动 OpenCode 实例，设置以下环境变量
# OPENCODE_HOST=localhost
# OPENCODE_PORT=4096

# 用户会话目录配置
# OpenCode serve 默认启动路径
# 默认值: /Users/wangpei/src/singe/SkllsFlow/user_session
USER_SESSION_BASE_PATH=/Users/wangpei/src/singe/SkllsFlow/user_session

# 认证配置
# 设置为 true 以强制要求认证（生产环境）
REQUIRE_AUTH=false

# Mock 模式
# 设置为 true 时不启动真实的 OpenCode 进程（用于开发测试）
MOCK_OPENCODE=false
