# 后端服务器配置
# NODE_ENV 会由启动命令自动设置（development/production/test）

# 后端服务器端口（Node.js Express 服务）
BACKEND_PORT=3001

# 后端服务器主机地址（IP 或域名）
# 开发环境默认为本地回环地址，生产环境可配置为实际服务器地址
BACKEND_HOST=127.0.0.1

# 前端开发服务器
# API 基础 URL 配置
# 开发环境：使用相对路径，通过 Vite 代理转发到后端
# 生产环境：配置完整的后端 URL（例如：https://api.example.com）
VITE_API_BASE_URL=/api

# API 模式切换 (MSW Mock)
# 设置为 true 时使用前端 Mock 数据（通过 MSW 拦截请求，不请求后端）
# 设置为 false 时使用真实后端 API（请求转发到 localhost:3001）
#
# 使用说明：
# 1. 修改此值后需要重启开发服务器 (pnpm dev)
# 2. Mock 模式下，浏览器控制台会显示 "[MSW] Mocking enabled" 日志
# 3. 业务代码无需修改，自动适配 Mock 或真实 API
VITE_MOCK=true

# 智能对话默认发送配置（可选）
# 不配置时，前端不会覆盖 agent/model，交给当前智能服务自身默认配置
# agent 和 model 可单独配置；若配置 model，需要 providerID + modelID 一起出现
# VITE_AI_CHAT_AGENT=custom-agent
# VITE_AI_CHAT_MODEL_PROVIDER_ID=opencode-go
# VITE_AI_CHAT_MODEL_ID=glm-5

# OpenCode 配置
# 如果已手动启动 OpenCode 实例，设置以下环境变量
# 格式: http://host:port 或 https://host:port
# 示例: OPENCODE_API_URL=http://localhost:4096
# OPENCODE_API_URL=


# 用户会话目录配置
# OpenCode serve 默认启动路径
OPENCODE_BASE_PATH=/Users/wangpei/src/singe/SkllsFlow/user_session

# Proxy 服务配置
PROXY_API_SECRET=your-proxy-secret-key

# OpenCode 认证配置
OPENCODE_AUTH=false
OPENCODE_PASSWORD=

# 认证配置
# 设置为 true 以强制要求认证（生产环境）
REQUIRE_AUTH=false

# JWT 配置
# 警告: 生产环境必须修改为强随机密钥！
# 可使用命令生成: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
